# Porta externa do frontend/Nginx (host -> container)
WEB_PORT=8080

# Porta local do PostgreSQL no host (somente loopback)
DB_PORT=5432

# Banco de dados PostgreSQL
POSTGRES_USER=erp
POSTGRES_PASSWORD=trocar-esta-senha
POSTGRES_DB=erp_industrial

# API
APP_NAME=ERP Industrial API
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1

# Ajuste para os domínios reais do frontend em produção
CORS_ALLOWED_ORIGINS=https://erp.seudominio.com

# Mantenha usuario, senha, host e db sincronizados com os valores acima
DATABASE_URL=postgresql+psycopg://erp:trocar-esta-senha@db:5432/erp_industrial
